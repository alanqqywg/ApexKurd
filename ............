<!DOCTYPE html>
<html lang="ckb" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>ApexKurd</title>
    <!-- ئەمە بۆ هێنانی لۆگۆی سۆشیاڵ میدیاکانە -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { margin: 0; padding: 0; font-family: sans-serif; background-color: #121212; color: white; }
        .logo { text-align: center; font-size: 32px; font-weight: bold; color: #ffce00; padding-top: 20px; }
        .container { margin-top: 30px; text-align: center; }
        .section { margin: 20px 0; }
        h2 { color: #d21034; border-bottom: 2px solid #d21034; display: inline-block; padding-bottom: 5px; margin-bottom: 15px; }
        .btn { display: block; background: #266b3c; color: white; padding: 15px; margin: 10px auto; width: 80%; max-width: 300px; border-radius: 8px; text-decoration: none; font-weight: bold; transition: 0.3s; }
        .btn:hover { background: #1a4d29; transform: scale(1.02); }
        
        /* بەشی خوارەوە */
        footer { margin-top: 50px; background: #000; padding: 20px; text-align: center; }
        .scrolling-name { font-size: 16px; color: white; margin-bottom: 15px; overflow: hidden; white-space: nowrap; }
        .text { animation: scroll 10s linear infinite; display: inline-block; }
        @keyframes scroll { from { transform: translateX(100%); } to { transform: translateX(-100%); } }
        
        /* سۆشیاڵ میدیا */
        .social-links { display: flex; justify-content: center; gap: 20px; margin-top: 10px; }
        .social-links a { font-size: 24px; color: white; transition: 0.3s; }
        .fa-discord:hover { color: #5865F2; }
        .fa-facebook:hover { color: #1877F2; }
        .fa-youtube:hover { color: #FF0000; }
    </style>
</head>
<body>

<div class="logo">ApexKurd</div>

<div class="container">
    <div class="section">
        <h2>بەشی موبایل</h2>
        <a href="#" class="btn">یاری موبایل</a>
        <a href="#" class="btn">ئەپی موبایل</a>
    </div>

    <div class="section">
        <h2>بەشی کۆمپیوتەر</h2>
        <a href="#" class="btn">یاری کۆمپیوتەر</a>
        <a href="#" class="btn">بەرنامەی کۆمپیوتەر</a>
    </div>
</div>

<footer>
    <div class="scrolling-name">
        <div class="text">دیزاین کراوە لەلایەن: ئەلان گۆڵسەر</div>
    </div>
    <div class="social-links">
        <a href="https://discord.gg/Xdsh53aYsA" target="_blank"><i class="fab fa-discord"></i></a>
        <a href="https://www.facebook.com/share/1HfHBL3iUB/" target="_blank"><i class="fab fa-facebook"></i></a>
        <a href="https://youtube.com/@alangullsar002?si=fdkBxEam4aw1TLtL" target="_blank"><i class="fab fa-youtube"></i></a>
    </div>
</footer>

</body>
</html>
